# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/wedding_ai

# === Redis / Queue ===
REDIS_URL=redis://localhost:6379

# === Storage (choose one) ===
STORAGE_PROVIDER=s3            # s3 | r2 | supabase
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=wedding-ai-photos-shrwak
STORAGE_REGION=eu-north-1

# === Face Recognition AI (choose one) ===
FACE_PROVIDER=aws_rekognition   # aws_rekognition | insightface_selfhosted | google_vision
AI_API_KEY=
AI_ENDPOINT=                    # required if self-hosted InsightFace

# === Payments (Saudi-first) ===
PAYMENT_PROVIDER=moyasar         # moyasar | hyperpay | tap | stripe
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# === Email / SMS / WhatsApp (optional, Phase 15+) ===
EMAIL_API_KEY=
WHATSAPP_API_KEY=

# === Auth ===
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Monitoring ===
SENTRY_DSN=
